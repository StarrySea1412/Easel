# Use only after comparing the base Python lock, OpenClaw package/dependencies,
# Node and Chromium versions against the selected release. Record the base ID.
ARG NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
ARG EASEL_DEPENDENCY_IMAGE
FROM ${NODE_IMAGE} AS frontend
WORKDIR /build
COPY web/frontend/package*.json ./
RUN npm ci
COPY web/frontend/ ./
COPY skills/ /skills/
RUN npm run build

FROM ${EASEL_DEPENDENCY_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends file && rm -rf /var/lib/apt/lists/*
RUN rm -rf /app/easel /app/web /app/scripts /app/skills /app/profiles /app/openclaw /app/deployment
WORKDIR /app
# The release exporter excludes credentials, user data and frontend dist.
# One copy avoids repeatedly scanning the large immutable dependency tree.
COPY . ./
COPY --from=frontend /build/dist/ ./web/frontend/dist/
# Exported source is readable; the audited dependency image already has its
# runtime permissions. Avoid copying the whole dependency tree for chmod.
RUN python deployment/138/install_locked_plugin.py && pip install --no-deps . && chmod -R a+rX /app
ARG EASEL_RELEASE_SHA
LABEL org.opencontainers.image.revision=${EASEL_RELEASE_SHA}
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "/app/deployment/138/supervisor.py"]
