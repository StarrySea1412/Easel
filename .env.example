# ============================================================
# Easel 环境变量 — 标准 Anthropic API key
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# Anthropic API Key：默认留空，首次使用在网页设置或此处填写真实密钥。
# 不放置占位密钥，避免首次启动被误标记为“已配置”。
ANTHROPIC_API_KEY=

# 旧模型变量（OpenClaw provider/model 格式）；新通道分别保存模型，互不覆盖。
CLAUDE_MODEL=anthropic/claude-sonnet-4-6

# 可选：Anthropic-compatible 服务
# ANTHROPIC_MODEL=claude-sonnet-4-6
# EASEL_LLM_MODEL=claude-sonnet-4-6
# EASEL_LLM_API_KEY=REPLACE_ME
# EASEL_LLM_BASE_URL=https://your-provider.example/v1
# EASEL_LLM_API_KEY_HEADER=api-key
# EASEL_LLM_ANTHROPIC_VERSION=2023-06-01

# OpenAI / OpenAI-compatible 服务
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 可选：独立向量/Embedding API（不配置则使用关键词记忆检索，不请求聊天 API 的 embedding 模型）
# EASEL_EMBEDDING_API_KEY=REPLACE_ME
# EASEL_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EASEL_EMBEDDING_MODEL=text-embedding-3-small

# OpenClaw gateway 端口
OPENCLAW_PORT=18789

# ============================================================
# 可选：媒体生成模型（也可在 Web「技能库」对应技能里填写）
# 只需配置实际使用的 provider；密钥留空不会启用。
# ============================================================

# 视频：dashscope / ark / kling / openai-compatible / xhs-maas / agnes
VIDEO_PROVIDER=
# AGNES_API_KEY=
# AGNES_MODEL=agnes-video-2.5-flash
# VIDEO_API_KEY=
# VIDEO_BASE_URL=
# VIDEO_MODEL=

# AI 音乐：dashscope / suno-compatible
MUSIC_PROVIDER=
# MUSIC_API_KEY=
# MUSIC_BASE_URL=
# MUSIC_MODEL=

# 云端 TTS：dashscope / minimax / fish-audio / openai-compatible / gemini
VOICE_PROVIDER=
# VOICE_API_KEY=
# VOICE_BASE_URL=
# VOICE_MODEL=
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# 多个媒体能力可复用同一份 DashScope key
# DASHSCOPE_API_KEY=

# ============================================================
# 可选：邮箱通知（easel-notify MCP + 完成钩子）
# 生成/发布完成后把结果发到邮箱。全部留空则不启用、零开销。
# QQ/163 等个人邮箱需在邮箱后台开「授权码」，填的不是登录密码。
# ============================================================
# 收件人，多个逗号分隔
# EASEL_NOTIFY_EMAIL=
# SMTP 主机：smtp.qq.com / smtp.163.com / smtp.exmail.qq.com / smtp.gmail.com …
# EASEL_NOTIFY_SMTP_HOST=
# 端口，默认 465
# EASEL_NOTIFY_SMTP_PORT=465
# 认证账号（缺省=首个收件人）
# EASEL_NOTIFY_SMTP_USER=
# 密码 / 授权码
# EASEL_NOTIFY_SMTP_PASS=
# 1（默认）=SSL(465)；0=STARTTLS(587)
# EASEL_NOTIFY_SMTP_SSL=1
# 发件人显示地址（缺省=认证账号或首个收件人）
# EASEL_NOTIFY_FROM=
# 置 1 临时整机关掉邮箱通知（不改配置）
# EASEL_NOTIFY_OFF=
